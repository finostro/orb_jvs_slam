<?xml version="1.0"?>
<package format="3">
  <name>hglmbslam</name>
  <version>0.0.2</version>
  <description>Stereo visual SLAM using the Joint Vector-Set (VGLMB) formulation with ORB features.</description>

  <maintainer email="felipe.inostroza@amtc.uchile.cl">Felipe Inostroza</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>gtsam</depend>
  <depend>sophus</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>fmt</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>boost</depend>
  <depend>libjemalloc-dev</depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
